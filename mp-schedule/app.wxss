/* 文件路径: /fjnu-nav/mp-schedule/app.wxss */
/* 全局样式：基础底色 + 深色主题 + 跨页复用的小组件（v1.3.2 补齐，勿再清空） */
page {
  background: #f5f6fa;
  color: #1f2329;
  font-size: 28rpx;
}
/* 每个页面的根容器：铺满一屏，深色时整页换底 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6fa;
  color: #1f2329;
}
.page.dark {
  background: #161616;
  color: #eceef2;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.mut { color: #8a8f99; font-size: 24rpx; }
/* 数据来源提示条：三页共用 */
.src { padding: 8rpx 24rpx; background: #fff8e1; color: #8a6d3b; font-size: 22rpx; }
.safe-bottom {
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
/* 空态：三页共用（页面 wxss 可覆盖） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 80rpx 24rpx;
  color: #8a8f99;
  font-size: 26rpx;
}
/* ---------- 深色主题（全局兜底） ---------- */
.dark .card { background: #1d1e22; box-shadow: none; }
.dark .mut { color: #9aa0ab; }
.dark .src { background: #2b2415; color: #d3b276; }
.dark .empty { color: #9aa0ab; }
