<!-- 文件路径: /fjnu-nav/mp-schedule/pages/board/board.wxml -->
<view class="page safe-bottom {{dark ? 'dark' : ''}}">
  <view class="b-head">
    <view class="b-title">💬 建议墙</view>
    <view class="b-sub mut">{{cloud ? '全班共享 · 实时可见' : '本机模式（云端未开通时建议仅存本机）'}}</view>
  </view>

  <!-- 发布框 -->
  <view class="b-form">
    <input class="b-nick" placeholder="署名（可留空）" value="{{nick}}" bindinput="onNick" maxlength="12" />
    <textarea class="b-input" placeholder="给课表提个建议…（≤200字）" value="{{draft}}" bindinput="onDraft" maxlength="200" />
    <view class="b-send" bindtap="send">发布</view>
  </view>

  <!-- 列表 -->
  <block wx:for="{{items}}" wx:key="_id">
    <view class="b-card">
      <view class="b-row">
        <text class="b-nick-t">{{item.nick}}</text>
        <text class="b-time mut">{{item.time}}</text>
      </view>
      <view class="b-text" data-i="{{index}}" bindtap="toggle">{{item.text}}</view>
      <view class="b-ops">
        <text class="b-op" data-i="{{index}}" catchtap="like">❤ {{item.likes || 0}}</text>
        <text class="b-op" data-i="{{index}}" catchtap="comment">💬 评论{{item.comments && item.comments.length ? ' ' + item.comments.length : ''}}</text>
      </view>
      <view wx:if="{{openId === index && item.comments && item.comments.length}}" class="b-cmts">
        <view wx:for="{{item.comments}}" wx:for-item="c" wx:key="index" class="b-cmt">
          <text class="bc-t">{{c.text}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !items.length}}" class="empty">
    <text>还没有建议，来第一条</text>
  </view>
  <view wx:if="{{loading}}" class="empty"><text>加载中…</text></view>
</view>
