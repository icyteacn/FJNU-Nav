/* 文件路径: /fjnu-nav/mp-schedule/pages/board/board.wxss */
/* 建议墙页：发布 + 列表 + 评论（v1.3.2 补齐，勿再清空） */
.b-head { padding: 24rpx 24rpx 8rpx; background: #fff; }
.b-title { font-size: 36rpx; font-weight: 700; }
.b-sub { margin-top: 4rpx; }

/* 发布区 */
.b-form {
  margin: 16rpx 24rpx 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.b-nick {
  border-bottom: 1rpx solid #eceef3;
  padding: 8rpx 4rpx 10rpx;
  font-size: 24rpx;
}
.b-input {
  width: 100%;
  min-height: 140rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.b-send {
  margin-top: 12rpx;
  background: #c62828;
  color: #fff;
  text-align: center;
  border-radius: 10rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}

/* 建议卡 */
.b-card {
  margin: 12rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.b-row { display: flex; justify-content: space-between; align-items: center; }
.b-nick-t { font-size: 24rpx; font-weight: 700; color: #c62828; }
.b-time { font-size: 20rpx; }
.b-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.55;
  word-break: break-all;
}
.b-ops {
  display: flex;
  gap: 32rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #f2f3f7;
  padding-top: 8rpx;
}
.b-op { font-size: 22rpx; color: #8a8f99; }
.b-cmts {
  margin-top: 8rpx;
  background: #fafbfd;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
}
.b-cmt { padding: 4rpx 0; }
.bc-t { font-size: 22rpx; color: #666; }

/* ---------- 深色 ---------- */
.page.dark .b-head { background: #1d1e22; }
.page.dark .b-title { color: #eceef2; }
.page.dark .b-form { background: #1d1e22; box-shadow: none; }
.page.dark .b-nick { border-color: #34363d; color: #eceef2; }
.page.dark .b-input { color: #eceef2; }
.page.dark .b-card { background: #1d1e22; box-shadow: none; }
.page.dark .b-nick-t { color: #ef9a9a; }
.page.dark .b-text { color: #eceef2; }
.page.dark .b-ops { border-color: #2c2e33; }
.page.dark .b-op { color: #9aa0ab; }
.page.dark .b-cmts { background: #232429; }
.page.dark .bc-t { color: #b0b6c0; }
