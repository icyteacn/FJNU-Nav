<!-- 文件路径: /fjnu-nav/mp-schedule/pages/schedule/schedule.wxml -->
<view class="page safe-bottom">
  <!-- 顶栏：专业 + 学期 + 周切换 + 搜索 -->
  <view class="top">
    <picker mode="selector" range="{{majors}}" range-key="label" value="{{majorIdx}}" bindchange="onMajor">
      <view class="major-pick">{{majorLabel}} ▾</view>
    </picker>
    <view class="week-pick">
      <text class="wk-btn" bindtap="prevWeek">‹</text>
      <text class="wk">第 {{week}} 周</text>
      <text class="wk-btn" bindtap="nextWeek">›</text>
    </view>
    <view class="search-btn" bindtap="goSearch">🔍</view>
    <view class="search-btn" bindtap="toggleView">{{viewMode === 'grid' ? '📋' : '📊'}}</view>
  </view>
  <view class="top2" wx:if="{{semesters.length > 1}}">
    <picker mode="selector" range="{{semesters}}" range-key="name" value="{{semIdx}}" bindchange="onSem">
      <view class="sem-pick">{{semesters[semIdx].name}} ▾</view>
    </picker>
  </view>

  <!-- 下一节课卡（对齐 App：标题+倒计时徽章+开关） -->
  <view class="next-card" wx:if="{{next && showNext}}">
    <view class="nc-head">
      <text class="nc-tag">⏰ 下一节课</text>
      <text wx:if="{{next.countdown}}" class="nc-cd">{{next.countdown}}</text>
      <text class="nc-off" catchtap="toggleNext">✕</text>
    </view>
    <view class="nc-name">{{next.name}}</view>
    <view class="nc-time">{{next.time}}</view>
    <view class="nc-sub" wx:if="{{next.teacher}}">{{next.teacher}} · {{next.remind}}</view>
  </view>
  <!-- 关闭后的折叠条：点按恢复 -->
  <view class="nc-mini" wx:if="{{next && !showNext}}" bindtap="toggleNext">⏰ 下节课：{{next.name}} {{next.countdown}} ▶</view>

  <!-- 周汇总行（对齐 App 顶行） -->
  <view class="wk-summary" wx:if="{{summary}}">
    <text>{{summary.range}}</text>
    <text class="wks-t">{{summary.text}}</text>
  </view>

  <!-- 近 14 天日程提醒条（对齐 App event 条） -->
  <view class="ev-bar" wx:for="{{evs}}" wx:key="index">
    <text class="ev-when">{{item.when}}</text>
    <text class="ev-title">{{item.title}}</text>
    <text class="ev-tip" wx:if="{{item.tip}}">{{item.tip}}</text>
  </view>

  <view class="src mut" wx:if="{{source==='cache'}}">⚠ 离线缓存数据（{{cacheT}} 更新）</view>

  <!-- ===== 列表模式（对齐 App 单日列表） ===== -->
  <view wx:if="{{viewMode === 'list'}}" class="list-view">
    <view class="day-chips">
      <view wx:for="{{days}}" wx:key="weekday"
            class="day-chip {{item.weekday === listDay ? 'on' : ''}} {{item.today ? 'today' : ''}}"
            data-d="{{item.weekday}}" bindtap="setListDay">
        <text class="dc-w">{{item.today ? '今' : weekCn[item.weekday - 1]}}</text>
        <text class="dc-d">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{listEmpty}}" class="list-empty">
      <text class="le-ico">{{listEmpty.icon}}</text>
      <text class="le-name">{{listEmpty.name}}</text>
      <text class="le-sub">{{listEmpty.sub}}</text>
    </view>

    <block wx:for="{{listItems}}" wx:key="index">
      <view wx:if="{{item.isGap}}" class="li-gap">{{item.gap}}</view>
      <view wx:else class="li {{item.badge}} {{item.kind}}" data-c="{{item}}" bindtap="showCourse">
        <view class="li-time"><text class="lt-s">{{item.timeStart}}</text><text class="lt-e">{{item.timeEnd}}</text></view>
        <view class="li-bar" style="background:{{item.color}}"></view>
        <view class="li-main">
          <view class="li-name">{{item.name}}
            <text wx:if="{{item.badge === 'live'}}" class="st-badge live">● 上课中</text>
            <text wx:elif="{{item.badge === 'next'}}" class="st-badge next">下一节</text>
            <text wx:elif="{{item.badge === 'done'}}" class="st-badge done">已结束</text>
          </view>
          <view class="li-meta">📍{{item.loc}} · {{item.teacher || '-'}} · {{item.periodText}}</view>
          <view wx:if="{{item.note}}" class="li-note">{{item.note}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 一屏全显：无滑动，节次高随屏高自适应 -->
  <view wx:if="{{viewMode === 'grid'}}" class="week-grid">
    <!-- 节次列 -->
    <view class="col head" style="width:{{headW}}px">
      <view class="cell-h">节</view>
      <view wx:for="{{periods}}" wx:key="*this" class="cell-p" style="height:{{cellH}}px">
        <text class="pn">{{item}}</text>
        <text class="pt">{{periodTimes[item]}}</text>
      </view>
    </view>
    <!-- 七天列 -->
    <view wx:for="{{days}}" wx:key="weekday" class="col" style="width:{{colW}}px">
      <!-- 列头：周几+日期+调休/调课徽标 -->
      <view class="cell-h {{item.today ? 'today' : ''}} {{item.holiday ? 'hol' : ''}}">
        <text class="hd-w">周{{weekCn[item.weekday - 1]}}</text>
        <text class="hd">{{item.label}}</text>
        <view wx:if="{{item.dayBadge}}" class="day-badge {{item.dayBadge.type}}">
          <text>{{item.dayBadge.icon}}{{item.dayBadge.text}}</text>
        </view>
      </view>
      <!-- 节假日：整列虚线停课卡（App 同款竖排） -->
      <view wx:if="{{item.holiday}}" class="holiday-cell" style="height:{{item.gridH}}px">
        <text class="holiday-ico">{{item.holiday.icon || '🎉'}}</text>
        <text class="holiday-v">{{item.holiday.name || item.holiday.descShort || '假期'}}</text>
        <text class="holiday-sub">假期停课</text>
      </view>
      <!-- 正常日：课程卡 -->
      <view wx:else class="day-body" style="height:{{item.gridH}}px">
        <view wx:for="{{item.cells}}" wx:for-item="c" wx:key="id"
              class="ccard {{c.kind}} {{c.status}} lv{{c.lv}}"
              style="top:{{c._top}}px;height:{{c._h}}px;border-left-color:{{c.color}}"
              data-c="{{c}}" bindtap="showCourse">
          <!-- 普通课：按节数分级（lv0课名/lv1+教室/lv2+教师/lv3+周次） -->
          <block wx:if="{{c.kind === 'course'}}">
            <text class="cc-name" style="color:{{c.color}}">{{c.name}}</text>
            <text wx:if="{{c.lv >= 1}}" class="cc-loc">@{{c.loc || '待定'}}</text>
            <text wx:if="{{c.lv >= 2 && c.teacher}}" class="cc-meta">{{c.teacher}}</text>
            <text wx:if="{{c.lv >= 3}}" class="cc-weeks">{{c.weeks}}</text>
          </block>
          <!-- 调入（补课） -->
          <block wx:elif="{{c.kind === 'incoming'}}">
            <text class="cc-in-badge">⬅调课</text>
            <text class="cc-name" style="color:#0369a1">{{c.name}}</text>
            <text wx:if="{{c.lv >= 1}}" class="cc-loc">@{{c.loc || '待定'}}</text>
          </block>
          <!-- 调走（原时段） -->
          <block wx:else>
            <text class="cc-mv-badge">↗调走</text>
            <text wx:if="{{c.lv >= 1}}" class="cc-name mv">{{c.course.name}}</text>
            <text wx:if="{{c.lv >= 2}}" class="cc-meta mv">{{c.movedNote}}</text>
          </block>
          <!-- 今日状态徽标 -->
          <text wx:if="{{c.status === 'live' && c.lv >= 1}}" class="cc-st live">上课中</text>
          <text wx:elif="{{c.status === 'done' && c.lv >= 2}}" class="cc-st done">已结束</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !courseCount}}" class="empty">
    <text>本周没有课程</text>
    <text class="mut">可切换周次或专业查看</text>
  </view>
  <view wx:if="{{loading}}" class="empty"><text>加载中…</text></view>
</view>
