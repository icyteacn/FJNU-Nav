<!-- 文件路径: /fjnu-nav/mp-weixin/pages/about/about.wxml -->
<view class="page safe-bottom">
  <view class="card center">
    <view class="logo">📚</view>
    <view class="name">福star课表</view>
    <view class="mut">v1.0.0 · 数据与福star导航网站同步</view>
  </view>

  <view class="card">
    <view class="row-item" bindtap="refresh">
      <text>🔄 刷新课表数据</text>
      <text class="mut">{{refreshText}}</text>
    </view>
    <view class="row-item" bindtap="copySite">
      <text>🌐 打开网页版（复制链接）</text>
      <text class="mut">icyteacn.github.io/FJNU-Nav</text>
    </view>
    <view class="row-item" bindtap="clearCache">
      <text>🗑 清除本地缓存</text>
      <text class="mut">重新拉取全部数据</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">数据说明</view>
    <view class="mut li">· 课表/日程与福star导航同源：data/schedule-data.json，启动自动同步、离线用缓存</view>
    <view class="mut li">· 数据仅供参考，以教务处正式通知为准</view>
    <view class="mut li">· 本应用数据存本机，不上传任何个人信息</view>
  </view>
</view>
